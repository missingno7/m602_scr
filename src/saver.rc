#include <windows.h>
#include "resource.h"
#include "version.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "M602 Screensaver"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION M602_VERSION_MAJOR, M602_VERSION_MINOR, 0, 0
PRODUCTVERSION M602_VERSION_MAJOR, M602_VERSION_MINOR, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "M602 Screensaver"
            VALUE "FileVersion", M602_VERSION_STRING
            VALUE "ProductName", "M602 Screensaver"
            VALUE "ProductVersion", M602_VERSION_STRING
            VALUE "OriginalFilename", "M602Saver.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_CONFIG DIALOGEX 0, 0, 250, 118
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "M602 Screensaver"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Speed:", IDC_SPEED_LABEL, 10, 13, 86, 10
    CONTROL         "", IDC_SPEED, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 96, 9, 148, 16
    LTEXT           "Color:", -1, 10, 34, 86, 10
    CONTROL         "", IDC_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 31, 70, 14
    PUSHBUTTON      "Original", IDC_COLOR_ORIGINAL, 176, 31, 64, 14
    LTEXT           "Scanlines:", -1, 10, 55, 86, 10
    COMBOBOX        IDC_SCANLINES, 100, 53, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Text area:", -1, 10, 75, 86, 10
    COMBOBOX        IDC_TEXTAREA, 100, 73, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Defaults", IDC_DEFAULTS, 10, 96, 54, 14
    DEFPUSHBUTTON   "OK", IDOK, 132, 96, 54, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 96, 54, 14
END
